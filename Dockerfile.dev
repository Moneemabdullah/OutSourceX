# Development image: source code is bind-mounted by Docker Compose at runtime.
FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

# Seed the image with Prisma files so an empty node_modules volume receives a
# generated client on first start. The bind mount supplies current source files.
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN DATABASE_URL=postgresql://localhost:5432/outsourcex npx prisma generate

EXPOSE 3000

CMD ["npm", "run", "dev"]
